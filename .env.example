# Copy to .env and fill in. .env is gitignored; never commit real values.

# Use Vertex AI rather than the AI Studio API-key path.
# (This variable was previously named GOOGLE_GENAI_USE_VERTEXAI.)
GOOGLE_GENAI_USE_ENTERPRISE=1

GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI location. Must be `global` — Gemini 3.5 models are not served from
# regional endpoints. This is NOT the Cloud Run region, which is a real
# physical region such as us-central1.
GOOGLE_CLOUD_LOCATION=global

# Bucket holding the low-resolution/ and low-annotations/ trees.
GCS_BUCKET_NAME=your-bucket-name

# Drive folder that outputs are written into, owned by the account you
# authorize with scripts/authorize_drive.py.
DRIVE_OUTPUT_FOLDER_ID=your-drive-folder-id

# Drive runs as a USER, not as the service account — service accounts have no
# Drive storage quota and every upload fails. Locally, scripts/authorize_drive.py
# writes drive_token.json and nothing below is needed.
#
# On Cloud Run, paste that token's JSON here from Secret Manager instead:
# GOOGLE_DRIVE_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}
#
# Optional: override where the local token file lives.
# GOOGLE_DRIVE_TOKEN_PATH=drive_token.json
